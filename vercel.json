{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "wab.celoxai.com" }],
      "destination": "/wab",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",        "value": "nosniff" },
        { "key": "X-Frame-Options",               "value": "DENY" },
        { "key": "Referrer-Policy",               "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",            "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection",              "value": "1; mode=block" },
        { "key": "Strict-Transport-Security",     "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy",       "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://dvjjxwcvxjgqpdcnnmvv.supabase.co wss://dvjjxwcvxjgqpdcnnmvv.supabase.co https://challenges.cloudflare.com https://data.gov.il https://vpic.nhtsa.dot.gov; img-src 'self' data: blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self';" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/wa-followups", "schedule": "0 7 * * *" }
  ]
}
