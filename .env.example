# Celox AI Fleet Manager Environment Variables

# Supabase Configuration
# Get these from your Supabase project settings (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend Email Configuration
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email recipient for contact form submissions
RESEND_RECIPIENT_EMAIL=your-email@example.com

# Optional: Development environment
VITE_ENV=development

# ── WhatsApp lead agent (wab.celoxai.com) ────────────────────────────────────
# Server-side only. Never expose these with a VITE_ prefix.

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# REQUIRED IN PRODUCTION since 2026-09-16 — verifies X-Hub-Signature-256.
# The webhook now fails closed (401) without this set in production; it used
# to silently skip verification, which was a live open-proxy hole. See the
# comment on signatureValid() in api/wa/webhook.js. Get it from Meta App
# Dashboard → your app → Settings → Basic → App Secret.
WHATSAPP_APP_SECRET=

# Calendly
CALENDLY_API_KEY=
CALENDLY_EVENT_URL=

# ── LLM backend, both the WhatsApp agent (api/_lib/claude.js) and the
# in-app avatar chatbot (api/avatar/chat.js) — tried in this order ──────────
# 1. On-prem (self-hosted VPS, OPTIONAL, not yet set up as of 2026-09-16)
# 2. Hugging Face free tier (OPTIONAL, lower-friction than a VPS)
# 3. Each feature's own cloud vendor below (NVIDIA / Gemini) — always on

# 1. On-prem — leave all three blank until the VPS from
# scripts/onprem-vps-bootstrap.sh exists. See docs/onprem-llm-setup.md.
ONPREM_LLM_URL=
ONPREM_LLM_API_KEY=
ONPREM_LLM_MODEL=

# 2. Hugging Face Inference Providers router — free, signup needs only an
# email (no payment method). Create a free-tier access token at
# huggingface.co/settings/tokens with the "Make calls to Inference Providers"
# scope, then set HF_MODEL to a "provider/model:backend" string from
# huggingface.co/docs/inference-providers (e.g.
# "meta-llama/Llama-3.1-8B-Instruct:novita" — verify the current exact tag
# there, provider/model availability changes). Deliberately has NO
# hardcoded default in code — see the comment atop api/_lib/hf-llm.js for
# why guessing a model id here has burned this app before. Leave both blank
# to skip this tier. Free credit is small (~$0.10/mo as of this writing) —
# fine at this app's volume with a cheap model, tight with a premium one.
HF_API_TOKEN=
HF_MODEL=

# 3a. NVIDIA NIM — powers the WhatsApp lead agent's cloud tier. Switched from
# Mistral 2026-09-09 after repeated Mistral billing/rate-limit outages. Free
# key at build.nvidia.com.
NVIDIA_API_KEY=
# Optional overrides; default to meta/llama-3.3-70b-instruct / qwen/qwen3-235b-a22b.
# claude.js also self-corrects against NVIDIA's live model catalog at call
# time, so a stale default here degrades rather than hard-fails.
WA_NVIDIA_MODEL=
WA_NVIDIA_FALLBACK_MODEL=

# 3b. Google Gemini — powers the avatar chatbot's cloud tier. Free key at
# aistudio.google.com/apikey. Free tier logs prompts to improve Google's
# products — fine for fleet-ops Q&A, worth knowing before anything more
# sensitive goes through this path.
GEMINI_API_KEY=
# Optional overrides; default to gemini-3.7-flash / gemini-3.5-flash.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Mistral / Anthropic — no longer used anywhere in this repo (WhatsApp agent
# moved Mistral → NVIDIA 2026-09-09; avatar chatbot moved Anthropic → Gemini
# 2026-08-24). Left blank and unused; safe to delete once nothing references
# them in the Vercel dashboard.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Supabase server credentials (the anon key above is the browser one)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gate for the dashboard API routes — must match VITE_MASTER_EMAIL
MASTER_EMAIL=

# Set by Vercel when you enable Cron; authenticates /api/cron/wa-followups
CRON_SECRET=
