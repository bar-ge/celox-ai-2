# Celox AI Fleet Manager Environment Variables

# Supabase Configuration
# Get these from your Supabase project settings (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend Email Configuration
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email recipient for contact form submissions
RESEND_RECIPIENT_EMAIL=your-email@example.com

# Optional: Development environment
VITE_ENV=development

# ── WhatsApp lead agent (wab.celoxai.com) ────────────────────────────────────
# Server-side only. Never expose these with a VITE_ prefix.

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional but recommended: Meta app secret, used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Calendly
CALENDLY_API_KEY=
CALENDLY_EVENT_URL=

# Mistral — powers the WhatsApp lead agent (api/_lib/claude.js), switched from
# Anthropic 2026-09-07. Get a key at console.mistral.ai/api-keys.
MISTRAL_API_KEY=
# Optional overrides; default to mistral-large-latest / mistral-small-latest.
WA_MISTRAL_MODEL=
WA_MISTRAL_FALLBACK_MODEL=

# Anthropic — no longer used by the WhatsApp agent (see MISTRAL_API_KEY above).
# Left here in case something else on this repo still wants it; safe to
# leave blank otherwise.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Supabase server credentials (the anon key above is the browser one)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gate for the dashboard API routes — must match VITE_MASTER_EMAIL
MASTER_EMAIL=

# Set by Vercel when you enable Cron; authenticates /api/cron/wa-followups
CRON_SECRET=
