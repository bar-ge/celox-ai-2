# Celox AI Fleet Manager Environment Variables

# Supabase Configuration
# Get these from your Supabase project settings (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend Email Configuration
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email recipient for contact form submissions
RESEND_RECIPIENT_EMAIL=your-email@example.com

# Optional: Development environment
VITE_ENV=development

# ── WhatsApp lead agent (wab.celoxai.com) ────────────────────────────────────
# Server-side only. Never expose these with a VITE_ prefix.

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# REQUIRED IN PRODUCTION since 2026-09-16 — verifies X-Hub-Signature-256.
# The webhook now fails closed (401) without this set in production; it used
# to silently skip verification, which was a live open-proxy hole. See the
# comment on signatureValid() in api/wa/webhook.js. Get it from Meta App
# Dashboard → your app → Settings → Basic → App Secret.
WHATSAPP_APP_SECRET=

# Google Calendar (replaced Calendly 2026-09-22) — see api/_lib/google-calendar.js
# Service account with domain-wide delegation (Workspace Admin Console >
# Security > API controls > Domain-wide delegation, granted 2026-09-23,
# scoped to https://www.googleapis.com/auth/calendar only) impersonating
# GOOGLE_CALENDAR_IMPERSONATE. Without impersonation Google refuses both
# attendee invites and Meet-link creation from a bare service account. Get
# client_email/private_key from the service account's downloaded JSON key —
# paste them directly, never re-derive or re-encode them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=office@celoxai.com
# Optional, defaults to GOOGLE_CALENDAR_ID. The real Workspace user the
# service account impersonates via domain-wide delegation.
GOOGLE_CALENDAR_IMPERSONATE=office@celoxai.com
# Public "Appointment schedule" booking-page link (Google Calendar → Booking
# pages → Copy link), used only as the dashboard's manual "send booking link"
# fallback — the agent books slots directly via the API above.
GOOGLE_CALENDAR_BOOKING_URL=
# Optional, default 45.
GOOGLE_CALENDAR_MEETING_MINUTES=45

# Calendly — RETIRED 2026-09-22, replaced by Google Calendar above. Left here
# only so the old values aren't silently orphaned in Vercel; safe to delete
# once confirmed unused.
CALENDLY_API_KEY=
CALENDLY_EVENT_URL=

# ── LLM backend, both the WhatsApp agent (api/_lib/claude.js) and the
# in-app avatar chatbot (api/avatar/chat.js) — OpenRouter only ──────────────
# Switched 2026-09-28 at Bar's request: OpenRouter is a single API/key
# fronting hundreds of models, so a future model swap is a Vercel env var
# change instead of a new vendor integration. This app had previously been
# through Anthropic → Mistral → NVIDIA → Anthropic for the WhatsApp bot, and
# Anthropic → Gemini for the avatar — see api/_lib/openrouter-llm.js for the
# shared client and full rationale. OpenRouter replaced BOTH the on-prem/
# Hugging-Face free pre-tiers AND each surface's previous cloud vendor — it
# is the only cloud vendor now, not one more tier in a ladder.

# Single key, both surfaces. Create at openrouter.ai/keys.
# (Name kept exactly as Bar specified — "OpenRouter" is one word everywhere
# else in this codebase's comments/docs, but the env var itself is
# OPEN_ROUTER_KEY.)
OPEN_ROUTER_KEY=
# Optional overrides; both default to meta-llama/llama-3.1-8b-instruct (the
# model Bar picked for both surfaces 2026-09-28). Model ids use OpenRouter's
# "org/model" shape — see openrouter.ai/models.
WA_OPEN_ROUTER_MODEL=
WA_OPEN_ROUTER_FALLBACK_MODEL=
AVATAR_OPEN_ROUTER_MODEL=
AVATAR_OPEN_ROUTER_FALLBACK_MODEL=

# On-prem / Hugging Face — no longer used by either surface (replaced by
# OpenRouter above, 2026-09-28). Left here only so old values aren't silently
# orphaned in Vercel; safe to delete once confirmed unused.
ONPREM_LLM_URL=
ONPREM_LLM_API_KEY=
ONPREM_LLM_MODEL=
HF_API_TOKEN=
HF_MODEL=

# Anthropic — no longer used (WhatsApp agent moved to OpenRouter, 2026-09-28).
# Left blank and unused; safe to delete once nothing references it in Vercel.
ANTHROPIC_API_KEY=

# NVIDIA NIM — no longer used (replaced by Anthropic, then OpenRouter).
# Left blank and unused; safe to delete once nothing references it in the
# Vercel dashboard.
NVIDIA_API_KEY=

# Google Gemini — no longer used (avatar chatbot moved to OpenRouter,
# 2026-09-28). Left blank and unused; safe to delete once nothing references
# it in the Vercel dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Mistral — no longer used anywhere in this repo. Left blank and unused; safe
# to delete once nothing references it in the Vercel dashboard.
MISTRAL_API_KEY=

# Supabase server credentials (the anon key above is the browser one)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gate for the dashboard API routes — must match VITE_MASTER_EMAIL
MASTER_EMAIL=

# Set by Vercel when you enable Cron; authenticates /api/cron/wa-followups
CRON_SECRET=
