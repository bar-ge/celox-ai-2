{
  "$description": "Celox AI design tokens — extracted from the live app (src/fleet-manager.jsx `C`, src/index.css). Source of truth is the code; update both together.",
  "color": {
    "nav": {
      "bg": "#2E2830",
      "border": "rgba(244,243,239,0.09)",
      "text": "#B9B3BF",
      "active": "#F4F3EF",
      "activeBg": "rgba(244,243,239,0.1)"
    },
    "brand": {
      "primary": "#2563EB",
      "primaryHover": "#1D4ED8",
      "indigo": "#6366F1",
      "gradient": "linear-gradient(135deg, #2563EB, #6366F1)"
    },
    "surface": {
      "bg": "#F4F3EF",
      "bgSubtle": "#F8F7F4",
      "surface": "#FFFFFF",
      "border": "#E5E1D8",
      "rowHover": "#F6F4EE",
      "footerBg": "#F8F7F4",
      "overlay": "rgba(43,38,48,0.55)"
    },
    "text": {
      "primary": "#2B2630",
      "secondary": "#5A5460",
      "muted": "#8F8A94"
    },
    "semantic": {
      "success": "#10B981",
      "successText": "#007A45",
      "danger": "#EF4444",
      "warning": "#F59E0B"
    },
    "branchPalette": ["#2563EB", "#10B981", "#8B5CF6", "#F59E0B", "#EF4444", "#06B6D4", "#F97316", "#EC4899"]
  },
  "typography": {
    "fontFamily": "'Heebo', system-ui, -apple-system, sans-serif",
    "monospace": "monospace (plates, codes, invoice numbers)",
    "sectionLabel": {
      "fontSize": 11,
      "fontWeight": 800,
      "letterSpacing": 0.7,
      "textTransform": "uppercase",
      "color": "{color.text.muted}"
    },
    "body": { "fontSize": 14 },
    "small": { "fontSize": 12, "usage": "table meta, hints" },
    "weights": { "regular": 400, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900 },
    "direction": "RTL (Hebrew) first; LTR (English) supported. Use logical properties (marginInlineStart etc.)."
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 12,
    "xxl": 16,
    "pill": 999,
    "note": "8 is the default for inputs/buttons/cards; 6 for compact controls; 999 for status badges"
  },
  "shadow": {
    "card": "0 1px 4px rgba(0,0,0,0.05)",
    "cardHover": "0 1px 8px rgba(0,0,0,0.06)",
    "primaryButton": "0 2px 10px rgba(59,130,246,0.35)",
    "modal": "0 24px 80px rgba(0,0,0,0.25)",
    "popover": "0 8px 40px rgba(0,0,0,0.2)"
  },
  "components": {
    "buttonPrimary": {
      "background": "{color.brand.gradient}",
      "color": "#FFFFFF",
      "borderRadius": 8,
      "fontWeight": 700,
      "boxShadow": "{shadow.primaryButton}"
    },
    "buttonGhost": {
      "background": "transparent",
      "border": "1px solid {color.surface.border}",
      "color": "{color.text.secondary}",
      "borderRadius": 6
    },
    "buttonDanger": {
      "background": "#EF444418",
      "color": "{color.semantic.danger}",
      "borderRadius": 6,
      "fontWeight": 600
    },
    "statusBadge": {
      "borderRadius": 999,
      "fontSize": 12,
      "fontWeight": 600,
      "pattern": "tinted background (color + '18'), solid dot, colored text"
    },
    "input": {
      "border": "1px solid {color.surface.border}",
      "borderRadius": 8,
      "padding": "10px 12px",
      "fontSize": 14,
      "background": "{color.surface.surface} or {color.surface.bg}"
    },
    "card": {
      "background": "{color.surface.surface}",
      "border": "1px solid {color.surface.border}",
      "borderRadius": 12,
      "boxShadow": "{shadow.card}"
    },
    "tableRow": {
      "padding": "12px 14px",
      "borderBottom": "1px solid {color.surface.border}",
      "hover": "{color.surface.rowHover}"
    }
  },
  "iconography": {
    "style": "24×24 viewBox, stroke currentColor, strokeWidth 2, round caps/joins, no fill",
    "defaultSize": 16,
    "set": ["car", "user", "building", "tool", "coin", "paperclip", "clipboard", "bell", "alert", "certificate", "award", "calendar", "download", "upload", "send", "gas", "phone", "mail", "link", "printer", "search", "eye", "pencil", "trash", "x", "check", "plus", "pause", "play", "next", "camera", "file", "fileText", "book", "receipt", "chart", "spreadsheet", "message", "lock", "shield", "shieldCheck", "folder", "image", "id", "hash", "ambulance", "qr", "clock", "copy", "settings", "users", "box", "traffic", "scale", "undo", "plug", "save", "eyeOff"]
  }
}
